---
import BaseLayout from '@/layouts/BaseLayout.astro'

const ingredients = [
	'Pan de bacon con lluvia de parmesano',
	'Carne de chuletón Black Angus',
	'Cheddar rojo madurado',
	'Pulled-cheese pork',
	'Salsa American BBQ',
	'Crujiente de cheddar',
	'Creamy cheese bacon',
]
---

<BaseLayout title='THE ONE | DAK Burger' description='DAK juega en casa en The Champions Burger Mijas con THE ONE, una burger creada exclusivamente para esta edición.'>
	<link slot='head' rel='preload' as='image' href='/the-one.jpg' />
	<!-- Hero -->
	<section
		id='hero'
		class='relative flex min-h-[100dvh] items-center justify-center overflow-hidden bg-dark pt-20'
	>
		<div id='hero-bg' class='absolute inset-0 overflow-hidden'>
			<img
				src='/the-one.jpg'
				alt='THE ONE - The Champions Burger Mijas'
				class='hero-zoom absolute inset-0 h-full w-full object-cover object-center'
				loading='eager'
				fetchpriority='high'
				decoding='async'
			/>
			<div class='absolute inset-0 bg-gradient-to-b from-dark/60 via-dark/30 to-dark/85'></div>
			<div class='absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(239,68,68,0.25),transparent_40%)]'></div>

			<!-- Aurora -->
			<div class='aurora pointer-events-none absolute inset-0' aria-hidden='true'>
				<div class='aurora-blob blob-1'></div>
				<div class='aurora-blob blob-2'></div>
				<div class='aurora-blob blob-3'></div>
			</div>
		</div>

		<div class='relative z-10 px-4 py-16 text-center'>
			<span
				class='animate-fade-in rounded-full border border-accent/50 bg-accent/20 px-5 py-2 text-xs font-bold uppercase tracking-[0.25em] text-white backdrop-blur-sm md:text-sm'
			>
				The Champions Burger Mijas
			</span>
			<h1
				class='mx-auto mt-8 max-w-5xl animate-slide-up font-heading text-4xl leading-tight text-white drop-shadow-2xl md:text-6xl lg:text-7xl'
			>
				HAY TENTACIONES A LAS QUE ES IMPOSIBLE DECIR QUE NO.
			</h1>
		</div>

		<!-- Dónde / Cuándo -->
		<div class='animate-slide-up absolute bottom-0 left-0 right-0 z-10 px-4 pb-8 [animation-delay:0.3s] md:pb-10'>
			<div class='mx-auto flex w-full max-w-3xl flex-col gap-3 sm:flex-row'>
				<!-- Mobile: combined -->
				<div
					class='flex items-center gap-4 rounded-2xl border border-white/20 bg-white/10 px-5 py-4 backdrop-blur-md sm:hidden'
				>
					<span class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/30 text-xl'>📅</span>
					<div>
						<p class='text-xs font-bold uppercase tracking-widest text-white/60'>Dónde y cuándo</p>
						<p class='mt-0.5 text-sm font-semibold text-white'>Del 20 de agosto al 6 de septiembre</p>
						<p class='text-sm font-semibold text-white'>Recinto Ferial de Las Lagunas · Mijas</p>
					</div>
				</div>
				<!-- Desktop: split -->
				<div
					class='hidden flex-1 items-center gap-4 rounded-2xl border border-white/20 bg-white/10 px-5 py-4 backdrop-blur-md sm:flex'
				>
					<span class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/30 text-xl'>📍</span>
					<div>
						<p class='text-xs font-bold uppercase tracking-widest text-white/60'>Dónde</p>
						<p class='mt-0.5 text-sm font-semibold text-white md:text-base'>Recinto Ferial de Las Lagunas · Mijas</p>
					</div>
				</div>
				<div
					class='hidden flex-1 items-center gap-4 rounded-2xl border border-white/20 bg-white/10 px-5 py-4 backdrop-blur-md sm:flex'
				>
					<span class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/40 text-xl'>📅</span>
					<div>
						<p class='text-xs font-bold uppercase tracking-widest text-white/60'>Cuándo</p>
						<p class='mt-0.5 text-sm font-semibold text-white md:text-base'>Del 20 de agosto al 6 de septiembre</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- THE ONE -->
	<section class='relative overflow-hidden bg-slate-50 py-20 md:py-28'>
		<div class='absolute -right-32 -top-32 h-64 w-64 rounded-full bg-primary/5'></div>
		<div class='absolute -bottom-16 -left-16 h-48 w-48 rounded-full bg-accent/5'></div>

		<div class='page-container relative grid items-center gap-14 lg:grid-cols-2'>
			<!-- Burger shot -->
			<div class='relative mx-auto w-full max-w-md px-2 sm:px-0' data-reveal>
				<div class='absolute -left-2 -top-4 h-full w-full rounded-[2rem] border-2 border-dashed border-accent/40 sm:-left-5 sm:-top-5'></div>
				<div class='absolute -bottom-3 -right-3 h-full w-full rounded-[2rem] bg-primary/10 sm:-bottom-6 sm:-right-6'></div>
				<div class='relative'>
					<img
						src='/the-one.jpg'
						alt='THE ONE - The Champions Burger Mijas'
						class='aspect-[3/4] w-full rounded-[2rem] object-cover shadow-2xl'
					/>
					<div class='absolute -bottom-5 left-1/2 -translate-x-1/2'>
						<div
							class='animate-float rounded-full bg-accent px-6 py-2 font-heading text-2xl text-white shadow-xl'
						>
							THE ONE
						</div>
					</div>
				</div>
			</div>

			<!-- Copy -->
			<div class='text-center lg:text-left' data-reveal>
				<span class='text-sm font-bold uppercase tracking-[0.25em] text-accent'>La exclusiva de esta edición</span>
				<h2 class='mt-3 font-heading text-7xl text-primary md:text-8xl lg:text-9xl'>THE ONE</h2>
				<p class='mx-auto mt-4 max-w-xl text-lg leading-8 text-slate-600 md:text-xl lg:mx-0'>
					DAK juega en casa en The Champions Burger Mijas con una burger creada exclusivamente para esta edición.
				</p>

				<!-- Ingredients -->
				<ul class='mx-auto mt-8 max-w-xl divide-y divide-slate-200/70 border-y border-slate-200/70 lg:mx-0'>
					{
						ingredients.map((item, i) => (
							<li
								class='flex items-center gap-4 py-3 text-left'
								data-reveal
								style={`transition-delay: ${i * 70}ms`}
							>
								<span
									class='flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent'
								>
									<svg class='h-3.5 w-3.5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='3' aria-hidden='true'>
										<path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7' />
									</svg>
								</span>
								<span class='text-sm font-medium text-slate-700'>{item}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class='page-container relative mt-16 text-center md:mt-20' data-reveal>
			<p class='mx-auto max-w-2xl text-lg font-light text-slate-600 md:text-xl'>
				Tranquilo. No hay infidelidad. Solo una burger capaz de hacerte caer.
			</p>
		</div>
	</section>

	<!-- Callout -->
	<section class='relative -mb-24 overflow-hidden bg-accent py-20 md:py-28'>
		<div class='absolute inset-0 opacity-10'>
			<div class='absolute -left-20 -top-20 h-72 w-72 rounded-full bg-white'></div>
			<div class='absolute -bottom-20 -right-20 h-96 w-96 rounded-full bg-white'></div>
		</div>
		<div class='page-container relative text-center' data-reveal>
			<h2 class='font-heading text-4xl text-white md:text-6xl'>ESTA VEZ, CAER EN LA TENTACION ESTA PERMITIDO.</h2>
		</div>
	</section>
</BaseLayout>

<script>
	const hero = document.getElementById('hero') as HTMLElement | null
	const heroBg = document.getElementById('hero-bg') as HTMLElement | null

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

	function updateHero() {
		if (!hero || !heroBg || prefersReducedMotion) return
		const progress = Math.min(Math.max(-hero.getBoundingClientRect().top / hero.offsetHeight, 0), 1)
		if (progress > 0) {
			const scale = 1 + progress * 0.18
			heroBg.style.transform = `scale(${scale})`
			heroBg.style.opacity = `${1 - progress * 0.65}`
		} else {
			heroBg.style.transform = ''
			heroBg.style.opacity = ''
		}
	}

	let ticking = false
	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				requestAnimationFrame(() => {
					updateHero()
					ticking = false
				})
				ticking = true
			}
		},
		{ passive: true }
	)

	updateHero()
</script>

<style>
	@keyframes hero-entry {
		from {
			transform: scale(1.35);
		}
		to {
			transform: scale(1);
		}
	}
	@keyframes hero-zoom {
		from {
			transform: scale(1);
		}
		to {
			transform: scale(1.14);
		}
	}
	.hero-zoom {
		animation:
			hero-entry 3s cubic-bezier(0.16, 1, 0.3, 1) both,
			hero-zoom 20s ease-in-out 3s infinite alternate;
	}

	@keyframes float-y {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}
	.animate-float {
		animation: float-y 6s ease-in-out infinite;
	}

	@keyframes aurora-drift-1 {
		0% {
			transform: translate(0, 0) scale(1);
		}
		100% {
			transform: translate(30vw, 18vh) scale(1.3);
		}
	}
	@keyframes aurora-drift-2 {
		0% {
			transform: translate(0, 0) scale(1);
		}
		100% {
			transform: translate(-25vw, 22vh) scale(1.25);
		}
	}
	@keyframes aurora-drift-3 {
		0% {
			transform: translate(0, 0) scale(1);
		}
		100% {
			transform: translate(20vw, -20vh) scale(1.35);
		}
	}
	.aurora-blob {
		position: absolute;
		border-radius: 9999px;
		filter: blur(70px);
		mix-blend-mode: screen;
		opacity: 0.35;
		animation-timing-function: ease-in-out;
		animation-direction: alternate;
		animation-iteration-count: infinite;
	}
	.blob-1 {
		width: 46vmax;
		height: 46vmax;
		left: -12%;
		top: -18%;
		background: radial-gradient(circle, rgba(239, 68, 68, 0.55), transparent 60%);
		animation-name: aurora-drift-1;
		animation-duration: 16s;
	}
	.blob-2 {
		width: 40vmax;
		height: 40vmax;
		right: -14%;
		bottom: -22%;
		background: radial-gradient(circle, rgba(13, 78, 145, 0.6), transparent 60%);
		animation-name: aurora-drift-2;
		animation-duration: 20s;
	}
	.blob-3 {
		width: 34vmax;
		height: 34vmax;
		left: 30%;
		top: 35%;
		background: radial-gradient(circle, rgba(255, 160, 60, 0.35), transparent 60%);
		animation-name: aurora-drift-3;
		animation-duration: 24s;
	}
</style>
